{
  "name": "@loom/api",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "node init && tsx watch src/main.ts",
    "build": "node init && tsc -p tsconfig.build.json",
    "start": "node init && node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts && tsx prisma/seed-advanced.ts",
    "provision:factory": "tsx scripts/provision-factory.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup": "node scripts/setup.mjs",
    "verify": "npm run format:check && npm run typecheck && npm test && npm run build",
    "audit": "npm audit --audit-level=moderate",
    "dev:all": "node init && node scripts/dev-all.mjs",
    "start:all": "node init && node scripts/dev-all.mjs --production",
    "verify:all": "node scripts/verify-all.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/websockets": "^11.1.0",
    "@nestjs/platform-socket.io": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@prisma/client": "7.10.1",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.63.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "helmet": "^8.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "zod": "^4.1.0",
    "@prisma/adapter-pg": "7.10.1"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "@types/node": "^24.0.0",
    "@types/express": "^5.0.3",
    "@types/cookie-parser": "^1.4.9",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=22.12"
  }
}
